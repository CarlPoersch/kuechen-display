<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ergänzt das von Xcode erzeugte Info.plist. Bonjour-Dienste, URL-Schemata und abgefragte Apps lassen sich nicht als Build-Einstellung angeben. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_androidtvremote2._tcp</string>
	</array>
	<!-- Spotify: prüfen, ob die Spotify-App installiert ist -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>
	<!-- Spotify: Rückweg nach der Anmeldung (Redirect URI hubert-spotify://callback) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.carlpoersch.HubertNext.spotify</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hubert-spotify</string>
			</array>
		</dict>
	</array>
	<!-- Radio: läuft weiter, wenn die App im Hintergrund ist oder der Bildschirm gesperrt -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Wecker (ab iOS 26): echte System-Wecker über AlarmKit -->
	<key>NSAlarmKitUsageDescription</key>
	<string>Hubert stellt deine Wecker so, dass sie auch bei gesperrtem Bildschirm, im Stumm-Modus und bei „Nicht stören“ klingeln.</string>
</dict>
</plist>
