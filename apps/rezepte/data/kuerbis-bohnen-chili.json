 "steps": [
  {
   "text": "Kürbis mit Schale in 2 cm große Würfel schneiden, Zwiebel und Knoblauch fein hacken."
  },
  {
   "text": "Zwiebel in Öl glasig dünsten, Knoblauch und Gewürze kurz mitrösten.",
   "minutes": 4
  },
  {
   "text": "Kürbis, Tomaten und Brühe zugeben und zugedeckt köcheln, bis der Kürbis fast weich ist.",
   "minutes": 20
  },
  {
   "text": "Bohnen abspülen, zugeben und offen weiterköcheln, bis das Chili sämig ist.",
   "minutes": 10
  },
  {
   "text": "Mit Salz und Limettensaft abschmecken."
  }
