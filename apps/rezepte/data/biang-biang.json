  "steps": [
    {
      "text": "Mehl und Salz mischen, Wasser nach und nach einrühren, bis ein zottiger Teig entsteht.",
      "use": [
        0,
        2,
        1
      ]
    },
    {
      "text": "Teig 10 Minuten glatt und elastisch kneten.",
      "minutes": 10,
      "use": []
    },
    {
      "text": "Abgedeckt 30 Minuten ruhen lassen.",
      "minutes": 30,
      "use": []
    },
    {
      "text": "Kurz durchkneten, in 6 gleich große Stücke teilen und zu länglichen Fladen formen.",
      "use": []
    },
    {
      "text": "Fladen rundum mit Öl bestreichen, abdecken und 1 Stunde ruhen lassen.",
      "minutes": 60,
      "use": [
        3
      ]
    },
    {
      "text": "Sojasauce, Essig und Zucker in einer Schüssel verrühren.",
      "use": [
        10,
        11,
        12
      ]
    },
    {
      "text": "Großen Topf mit Wasser zum Kochen bringen.",
      "use": [
        1
      ]
    },
    {
      "text": "Einen Fladen flach drücken, mit einem Stäbchen der Länge nach eine Rille eindrücken, an den Enden fassen und unter leichtem Schlagen auf die Arbeitsfläche auf ca. 1 m Länge ziehen. Entlang der Rille in zwei Hälften reißen.",
      "use": []
    },
    {
      "text": "Nudeln 1–2 Minuten kochen, bis sie oben schwimmen. Pak Choi in der letzten Minute mitgaren.",
      "minutes": 2,
      "use": [
        13
      ]
    },
    {
      "text": "Nudeln abtropfen lassen, in Schalen geben, Sauce darüber. Knoblauch, Frühlingszwiebeln, Chili, Sichuanpfeffer und Kreuzkümmel obenauf häufen.",
