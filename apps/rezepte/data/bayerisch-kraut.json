 "steps": [
  {
   "text": "Kohl vierteln, Strunk entfernen und in feine Streifen schneiden."
  },
  {
   "text": "Speck auslassen, Zwiebel zugeben und glasig dünsten. Zucker darüberstreuen und leicht karamellisieren."
  },
  {
   "text": "Kohl zugeben und kurz anbraten, mit Essig und Brühe ablöschen, Kümmel zugeben."
  },
  {
   "text": "Zugedeckt weich schmoren.",
