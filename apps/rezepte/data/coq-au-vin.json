 "steps": [
  {
   "text": "Hähnchen salzen und pfeffern. Speck im Bräter auslassen und herausnehmen.",
   "minutes": 4
  },
  {
   "text": "Hähnchen im Fett rundum goldbraun anbraten und herausnehmen.",
   "minutes": 10
  },
  {
   "text": "Zwiebeln und Pilze anbraten, Knoblauch zugeben.",
   "minutes": 5
  },
  {
   "text": "Mehl darüberstäuben, kurz anschwitzen, dann mit Wein und Brühe ablöschen."
  },
  {
   "text": "Hähnchen, Speck und Kräuter zurückgeben und zugedeckt schmoren.",
   "minutes": 75
  },
  {
   "text": "Sauce bei Bedarf einkochen und mit der Butter verfeinern. Dazu Baguette oder Kartoffeln."
  }
