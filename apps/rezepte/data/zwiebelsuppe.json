 "steps": [
  {
   "text": "Zwiebeln in feine Ringe schneiden."
  },
  {
   "text": "In Butter mit dem Zucker bei mittlerer Hitze langsam tief goldbraun karamellisieren, regelmäßig rühren.",
   "minutes": 40
  },
  {
   "text": "Mehl darüberstäuben und kurz anschwitzen, mit Wein ablöschen."
  },
  {
   "text": "Brühe und Thymian zugeben und köcheln.",
   "minutes": 20
  },
  {
   "text": "Baguettescheiben mit Käse belegen und im Airfryer bei 200 °C überbacken, bis der Käse blubbert.",
   "minutes": 4
  },
  {
   "text": "Suppe in Schalen füllen und die Käsebrote darauflegen."
