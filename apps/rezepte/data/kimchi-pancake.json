 "steps": [
  {
   "text": "Kimchi klein schneiden. Mit Mehl, Stärke, Wasser, Kimchi-Saft und Frühlingszwiebeln zu einem dickflüssigen Teig rühren."
  },
  {
   "text": "Öl in einer Pfanne stark erhitzen und den Teig dünn verstreichen."
  },
  {
   "text": "Knusprig braten, wenden und auch die zweite Seite bräunen.",
   "minutes": 8
  },
  {
   "text": "Für den Dip Sojasauce, Essig und Sesam mischen. Pfannkuchen in Stücke schneiden."
  }
