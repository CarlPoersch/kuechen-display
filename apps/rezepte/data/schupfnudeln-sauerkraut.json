 "steps": [
  {
   "text": "Zwiebel in Streifen schneiden. Sauerkraut abtropfen lassen."
  },
  {
   "text": "Speck in einer großen Pfanne knusprig braten, Zwiebel zugeben und glasig dünsten.",
   "minutes": 5
  },
  {
   "text": "Sauerkraut, Kümmel, Zucker und Brühe zugeben und zugedeckt schmoren.",
   "minutes": 10
  },
  {
   "text": "Schupfnudeln in einer zweiten Pfanne in Butterschmalz rundum goldbraun braten.",
   "minutes": 8
  },
  {
   "text": "Alles mischen und mit Salz und Pfeffer abschmecken."
  }
