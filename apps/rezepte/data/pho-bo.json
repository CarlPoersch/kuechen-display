 "steps": [
  {
   "text": "Knochen und Brust in Wasser aufkochen, 5 Minuten kochen, abgießen und abspülen. Warum: Die Brühe wird klar.",
   "minutes": 5
  },
  {
   "text": "Zwiebeln und Ingwer halbiert in einer Pfanne ohne Fett schwarz rösten, Gewürze kurz mitrösten.",
   "minutes": 8
  },
  {
   "text": "Alles mit 2,5 l frischem Wasser aufsetzen und sanft simmern, nicht sprudelnd kochen.",
   "minutes": 150
  },
  {
   "text": "Brust nach 2 Stunden herausnehmen und in Scheiben schneiden."
  },
  {
   "text": "Brühe abseihen, mit Fischsauce und Zucker abschmecken."
  },
  {
   "text": "Nudeln nach Packung garen und auf Schalen verteilen.",
   "minutes": 5
  },
  {
   "text": "Brust und rohes Filet darauflegen und mit kochender Brühe übergießen, das Filet gart dabei."
  },
  {
   "text": "Mit Kräutern, Sprossen, Limette, Chili und Saucen servieren."
  }
