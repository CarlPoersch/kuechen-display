 "steps": [
  {
   "text": "Nudeln in lauwarmem Wasser einweichen, bis sie biegsam sind.",
   "minutes": 25
  },
  {
   "text": "Sauce verrühren, bis der Zucker gelöst ist."
  },
  {
   "text": "Öl im Wok erhitzen, Knoblauch und Garnelen 2 Minuten braten und an den Rand schieben.",
   "minutes": 2
  },
  {
   "text": "Eier in den Wok schlagen und verrühren, bis sie fast gestockt sind."
  },
  {
   "text": "Nudeln und Sauce zugeben und 3 Minuten braten, bis die Nudeln weich sind. Bei Bedarf einen Schuss Wasser zugeben.",
   "minutes": 3
  },
  {
   "text": "Sprossen und Frühlingszwiebeln unterheben. Mit Erdnüssen, Chili und Limettenspalten servieren."
  }
