 "steps": [
  {
   "text": "Papaya und Karotte schälen und in feine Streifen hobeln."
  },
  {
   "text": "Bohnen in 3 cm Stücke schneiden, Tomaten halbieren."
  },
  {
   "text": "Knoblauch und Chilis im Mörser zerstoßen, dann Zucker, Fischsauce und Limettensaft verrühren."
  },
  {
   "text": "Bohnen und Tomaten zugeben und leicht andrücken."
  },
  {
   "text": "Papaya und Karotte unterheben und kurz mit dem Stößel durchklopfen, damit sie das Dressing aufnehmen."
  },
  {
   "text": "Mit Erdnüssen bestreut sofort servieren."
  }
