 "steps": [
  {
   "text": "Mehl, Eier, Wasser und Salz zu einem zähen Teig schlagen, bis er Blasen wirft.",
   "minutes": 5
  },
  {
   "text": "Teig ruhen lassen.",
   "minutes": 15
  },
  {
   "text": "Zwiebeln in Ringe schneiden und in Butter langsam goldbraun braten.",
   "minutes": 15
  },
  {
   "text": "Teig portionsweise in kochendes Salzwasser schaben oder pressen. Sobald die Spätzle oben schwimmen, abschöpfen."
  },
  {
   "text": "Lagenweise mit Käse in eine Airfryer-geeignete Form schichten und bei 160 °C kurz überbacken, bis der Käse schmilzt.",
   "minutes": 4
  },
  {
   "text": "Mit Röstzwiebeln und Schnittlauch servieren."
  }
