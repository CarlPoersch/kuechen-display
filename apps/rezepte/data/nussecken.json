 "steps": [
  {
   "text": "Mehl, Backpulver, Zucker, Ei und Butter rasch zu einem Mürbeteig verkneten und auf einem Blech (ca. 30 × 40 cm) ausrollen."
  },
  {
   "text": "Teig mit Marmelade bestreichen. Backofen auf 180 °C vorheizen."
  },
  {
   "text": "Butter, Zucker und Wasser aufkochen, Nüsse unterrühren und abkühlen lassen.",
   "minutes": 5
  },
  {
   "text": "Nussmasse auf dem Teig verteilen und backen, bis sie goldbraun ist.",
   "minutes": 25
  },
  {
   "text": "Abkühlen lassen, in Quadrate und dann in Dreiecke schneiden.",
   "minutes": 20
  },
  {
   "text": "Die Ecken in geschmolzene Kuvertüre tauchen und fest werden lassen."
  }
