 "steps": [
  {
   "text": "Mehl, Dashi und Eier zu einem dicken Teig verrühren."
  },
  {
   "text": "Kohl und Frühlingszwiebeln unterheben."
  },
  {
   "text": "Etwas Öl in einer Pfanne erhitzen, die Hälfte des Teigs zu einem 2 cm dicken Fladen formen, Fleisch darauflegen."
  },
  {
   "text": "Bei mittlerer Hitze braten.",
   "minutes": 5
  },
  {
   "text": "Vorsichtig wenden (mit Hilfe eines Tellers) und weiterbraten, bis er durch ist.",
   "minutes": 5
  },
  {
   "text": "Mit Sauce und Mayonnaise bestreichen, mit Bonito und Aonori bestreuen. Zweiten Fladen genauso backen."
  }
 ],
