 "steps": [
  {
   "text": "Kartoffeln in 1 cm dicke Stifte schneiden."
  },
  {
   "text": "In kaltem Wasser einweichen. Warum: Das spült Stärke aus, die Pommes werden knuspriger statt klebrig.",
   "minutes": 20
  },
  {
   "text": "Gründlich trocken tupfen, mit Stärke bestäuben und mit Öl mischen."
  },
  {
   "text": "Bei 180 °C garen, alle 5 Minuten den Korb schütteln.",
   "minutes": 20
  },
  {
   "text": "Auf 200 °C erhöhen und goldbraun knuspern lassen.",
   "minutes": 5
  },
  {
   "text": "Sofort salzen (und mit Paprika würzen)."
  }
