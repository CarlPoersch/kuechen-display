 "steps": [
  {
   "text": "Hähnchenschenkel salzen und pfeffern, in Öl auf der Hautseite knusprig braten, wenden und herausnehmen.",
   "minutes": 10
  },
  {
   "text": "Zwiebel, Paprika und Pilze in Streifen schneiden und im Bratfett anbraten, Knoblauch kurz mitbraten.",
   "minutes": 6
  },
  {
   "text": "Mit Rotwein ablöschen und kurz einkochen lassen.",
   "minutes": 2
  },
  {
   "text": "Tomaten, Rosmarin und Oliven zugeben, Hähnchen mit der Haut nach oben daraufsetzen und zugedeckt schmoren.",
   "minutes": 30
  },
  {
   "text": "Abschmecken – dazu Ciabatta, Polenta oder Pasta."
  }
