 "steps": [
  {
   "text": "Reis waschen, bis das Wasser klar ist, abtropfen lassen."
  },
  {
   "text": "Zwiebel fein würfeln und in Butter mit Zimt und Kardamom goldgelb dünsten.",
   "minutes": 5
  },
  {
   "text": "Reis zugeben und kurz glasig rühren.",
   "minutes": 2
  },
  {
   "text": "Brühe und Rosinen zugeben, aufkochen und zugedeckt bei kleinster Hitze garen.",
   "minutes": 15
  },
  {
   "text": "Mandeln rösten und unter den aufgelockerten Reis heben."
  }
