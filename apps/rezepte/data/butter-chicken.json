 "steps": [
  {
   "text": "Hähnchen mit Joghurt und den Gewürzen marinieren (gern auch über Nacht).",
   "minutes": 60
  },
  {
   "text": "Hähnchen im Airfryer bei 200 °C rösten, bis die Ränder Farbe haben. Nach der Hälfte den Korb schütteln.",
   "minutes": 12
  },
  {
   "text": "Butter im Topf schmelzen, Zwiebel glasig dünsten, Knoblauch und Ingwer 1 Minute mitbraten.",
   "minutes": 6
  },
  {
   "text": "Tomaten zugeben und einköcheln lassen.",
   "minutes": 15
  },
  {
   "text": "Basmatireis kochen.",
   "minutes": 15
  },
  {
   "text": "Sahne, Zucker und Hähnchen zugeben und köcheln, bis das Fleisch gar ist.",
   "minutes": 10
  },
  {
   "text": "Kasuri Methi zwischen den Fingern zerreiben und unterrühren."
