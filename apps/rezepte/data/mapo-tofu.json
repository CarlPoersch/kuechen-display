 "steps": [
  {
   "text": "Reis kochen.",
   "minutes": 15
  },
  {
   "text": "Tofu in 2 cm große Würfel schneiden und 2 Minuten in leicht gesalzenem Wasser ziehen lassen, dann abgießen.",
   "minutes": 2
  },
  {
   "text": "Öl erhitzen, Hackfleisch krümelig und knusprig braten.",
   "minutes": 4
  },
  {
   "text": "Doubanjiang, schwarze Bohnen, Knoblauch und Ingwer 1 Minute mitbraten, bis das Öl rot wird."
  },
  {
   "text": "Brühe und Sojasauce angießen, Tofu vorsichtig hineingeben und 5 Minuten köcheln.",
   "minutes": 5
  },
  {
   "text": "Mit Stärke binden, mit Sichuanpfeffer und Frühlingszwiebeln bestreuen und mit Reis servieren."
  }
