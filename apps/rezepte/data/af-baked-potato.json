 "steps": [
  {
   "text": "Kartoffeln waschen, trocknen, mehrmals mit einer Gabel einstechen und mit Öl und Salz einreiben."
  },
  {
   "text": "Bei 200 °C garen, nach der Hälfte wenden, bis ein Messer leicht hineingleitet.",
   "minutes": 40
  },
  {
   "text": "Quark mit Milch, Knoblauch, gehackten Kräutern, Salz und Pfeffer cremig rühren."
  },
  {
   "text": "Speck in den letzten 5 Minuten in einer kleinen Form mit in den Airfryer stellen."
  },
  {
   "text": "Kartoffeln kreuzweise einschneiden, etwas aufdrücken, mit Quark, Speck und Röstzwiebeln füllen."
  }
