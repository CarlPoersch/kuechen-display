 "steps": [
  {
   "text": "Mascarpone, Quark, Zucker und Vanillezucker glatt rühren, Sahne steif schlagen und unterheben."
  },
  {
   "text": "Lebkuchen kurz in Kaffee tauchen und eine Form damit auslegen."
  },
  {
   "text": "Die Hälfte der Creme darauf streichen, wieder Lebkuchen, dann die restliche Creme schichten."
  },
  {
   "text": "Abgedeckt im Kühlschrank durchziehen lassen.",
   "minutes": 180
  },
  {
   "text": "Kakao mit Zimt mischen und vor dem Servieren darübersieben."
  }
