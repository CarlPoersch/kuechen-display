 "steps": [
  {
   "text": "Frischen Grünkohl von den Stielen zupfen, waschen, 2 Minuten blanchieren und grob hacken."
  },
  {
   "text": "Zwiebeln würfeln, in Schmalz glasig dünsten, Grünkohl und Brühe zugeben und zugedeckt schmoren.",
   "minutes": 60
  },
  {
   "text": "Haferflocken und Senf unterrühren, Kassler und Pinkel auf den Kohl legen und weiter schmoren.",
   "minutes": 30
  },
  {
   "text": "Kartoffeln kochen, pellen und in Butter mit Zucker karamellisieren.",
   "minutes": 25
  },
  {
   "text": "Grünkohl mit Salz und Pfeffer abschmecken und mit Fleisch und Kartoffeln servieren."
