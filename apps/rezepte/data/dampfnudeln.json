 "steps": [
  {
   "text": "Hefe in Milch mit 1 TL Zucker auflösen. Mit Mehl, restlichem Zucker, Butter, Ei und Salz zu einem glatten Teig kneten."
  },
  {
   "text": "Abgedeckt gehen lassen, bis er doppelt so groß ist.",
   "minutes": 60
  },
  {
   "text": "8 Kugeln formen und nochmals gehen lassen.",
   "minutes": 20
  },
  {
   "text": "In einem breiten Topf mit Deckel Milch, Butter und Zucker aufkochen, Kugeln hineinsetzen."
  },
  {
   "text": "Zugedeckt bei kleiner Hitze garen, bis es knistert und unten eine Kruste entsteht. Deckel nicht öffnen!",
   "minutes": 25
  },
  {
   "text": "Vanillesauce nach Packung kochen und dazu servieren."
  }
